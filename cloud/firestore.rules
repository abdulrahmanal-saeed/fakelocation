rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['deleting'])
        && request.resource.data.deleting == true && request.time.toMillis() / 1000 - request.auth.token.auth_time < 300;
      match /backups/{group} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.auth.token.email_verified == true
          && group in ['core','history','places','parking']
          && request.resource.data.keys().hasOnly(['backup','drives'])
          && request.resource.data.backup is string && request.resource.data.drives is string
          && !exists(/databases/$(database)/documents/users/$(uid));
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_overline"
            android:textColor="@color/action"
            android:textSize="13sp" />

        <TextView
            style="@style/Text.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_title" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/setup_subtitle"
            android:textSize="15sp" />

        <!-- Step: location -->
        <LinearLayout
            android:id="@+id/stepLocation"
            style="@style/SetupStep"
            android:layout_marginTop="20dp">

            <TextView android:id="@+id/stepLocationBadge" style="@style/SetupBadge" android:text="1" />

            <LinearLayout style="@style/SetupStepText">
                <TextView style="@style/Text.Item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_location" />
                <TextView android:id="@+id/stepLocationStatus" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allowLocation"
                style="@style/Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allow" />
        </LinearLayout>

        <!-- Step: notifications -->
        <LinearLayout
            android:id="@+id/stepNotifications"
            style="@style/SetupStep"
            android:layout_marginTop="10dp">

            <TextView android:id="@+id/stepNotificationsBadge" style="@style/SetupBadge" android:text="2" />

            <LinearLayout style="@style/SetupStepText">
                <TextView style="@style/Text.Item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_notifications" />
                <TextView android:id="@+id/stepNotificationsStatus" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allowNotifications"
                style="@style/Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allow" />
        </LinearLayout>

        <!-- Step: mock location app -->
        <LinearLayout
            android:id="@+id/stepMock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView android:id="@+id/stepMockBadge" style="@style/SetupBadge" android:text="3" />

                <LinearLayout style="@style/SetupStepText">
                    <TextView style="@style/Text.Item" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_mock" />
                    <TextView android:id="@+id/stepMockStatus" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_mock_hint" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stepMockDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/step_mock_how"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openDeveloperOptions"
                    style="@style/Button.Action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/open_developer_options"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            style="@style/Button.Ink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_to_map" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="26th of July St" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                tools:text="Zamalek, Cairo · 3.2 km from you" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoriteButton"
            style="@style/IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/save_favorite"
            app:backgroundTint="@color/action_tint"
            app:icon="@drawable/ic_star"
            app:iconTint="@color/action" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_round"
        android:backgroundTint="@color/ground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/coords"
            style="@style/Text.Mono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textIsSelectable="true"
            tools:text="30.06132, 31.21954" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copyButton"
            style="@style/IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/copy_coordinates"
            app:backgroundTint="@color/surface"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_copy"
            app:iconSize="18dp"
            app:iconTint="@color/ink_soft" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/teleportButton"
        style="@style/Button.Action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/teleport_here"
        android:textSize="17sp"
        app:icon="@drawable/ic_pin" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backButton"
                    style="@style/IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/back"
                    app:backgroundTint="@color/ground"
                    app:icon="@drawable/ic_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timing_title"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/routeName"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Morning errands" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/timingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:checkedButton="@id/timingNow"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timingNow"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start_now" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timingStartAt"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/start_at" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timingArriveBy"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/arrive_by" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/timeButton"
                style="@style/Button.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:icon="@drawable/ic_clock"
                tools:text="Arrive by 15:00 · today"
                tools:visibility="visible" />

            <!-- Repeat every week on these days (start at / arrive by only). -->
            <LinearLayout
                android:id="@+id/repeatRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_on" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/dayGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:singleSelection="false">

                    <com.google.android.material.button.MaterialButton android:id="@+id/day1" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/day2" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/day3" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/day4" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/day5" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/day6" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/day7" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/repeatHint"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    tools:text="Runs every Mon–Fri. Next: Monday 07:30" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_round"
                android:backgroundTint="@color/ink"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/fake" />

                <TextView
                    android:id="@+id/headlineCaption"
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_weight="1"
                    android:textColor="@color/muted_light"
                    tools:text="To reach Cairo Tower by 15:00 it starts at" />

                <TextView
                    android:id="@+id/headlineTime"
                    style="@style/Text.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/surface"
                    android:textSize="26sp"
                    tools:text="13:37" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_round"
                android:backgroundTint="@color/ground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Item"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/natural_movement" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/natural_movement_hint"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/naturalSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/natural_movement" />
            </LinearLayout>

            <!-- How the fake trip runs: speed, the way back, laps. -->
            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/trip_options" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/trip_speed" />

            <!-- Labels (0.5× … 3×) are set in code from TRIP_SPEEDS, in this order. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/speedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton android:id="@+id/speed1" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/speed2" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/speed3" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/speed4" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/speed5" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/speed6" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/trip_way" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/wayGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:checkedButton="@id/wayOne"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wayOne"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/way_one" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wayBack"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/way_back" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/lapsLabel"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/trip_laps" />

            <!-- Labels (1× … 10×) are set in code from LAP_CHOICES, in this order. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/lapsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton android:id="@+id/laps1" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/laps2" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/laps3" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/laps4" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/laps5" style="@style/Tab.Compact" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/lapsHint"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/laps_need_loop"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/total"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                tools:text="Total 1h 23m · 12.4 km" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startButton"
            style="@style/Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_trip"
            app:icon="@drawable/ic_play" />
    </LinearLayout>
</LinearLayout>

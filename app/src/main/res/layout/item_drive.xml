<?xml version="1.0" encoding="utf-8"?>
<!-- One drive: where to, when, and what it cost. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View style="@style/Divider" />

    <LinearLayout style="@style/SettingsRow">
        <LinearLayout style="@style/SettingsRowText">
            <TextView
                android:id="@+id/destination"
                style="@style/Text.Item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Dubai Mall" />
            <TextView
                android:id="@+id/detail"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="Thu 30 Oct 07:42 · 18.4 km · 24 min · 46 km/h" />
        </LinearLayout>
        <TextView
            android:id="@+id/cost"
            style="@style/SettingsRowValue"
            tools:text="AED 12" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/NavField"
    android:layout_marginTop="6dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/stopNumber"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/dot"
        android:backgroundTint="@color/nav_blue"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="1" />

    <TextView
        android:id="@+id/stopName"
        style="@style/NavFieldText"
        tools:text="ENOC Al Wasl" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopRemove"
        style="@style/IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/nav_remove_stop"
        app:icon="@drawable/ic_close"
        app:iconSize="16dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Planning: from / to -->
        <LinearLayout
            android:id="@+id/planCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeButton"
                    style="@style/IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/back"
                    app:backgroundTint="@color/ground"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_back"
                    app:iconSize="20dp" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/nav_title"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/modeCar"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeCar"
                        style="@style/Tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="36dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/mode_car"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeWalk"
                        style="@style/Tab"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="36dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/mode_walk"
                        android:textSize="13sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/fromRow"
                        style="@style/NavField">

                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/dot"
                            android:backgroundTint="@color/real" />

                        <TextView
                            android:id="@+id/fromText"
                            style="@style/NavFieldText"
                            tools:text="My real location" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/toRow"
                        style="@style/NavField"
                        android:layout_marginTop="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_m_arrive"
                            app:tint="@color/ink" />

                        <TextView
                            android:id="@+id/toText"
                            style="@style/NavFieldText"
                            tools:text="Choose destination" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/swapButton"
                    style="@style/IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/nav_swap"
                    app:backgroundTint="@color/ground"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_swap"
                    app:iconSize="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Driving: next instruction -->
        <LinearLayout
            android:id="@+id/instructionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round"
            android:backgroundTint="@color/nav_blue"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/lanesRow"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_round"
                android:backgroundTint="#33FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/maneuverIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_m_left"
                    app:tint="@color/surface" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/maneuverDistance"
                        style="@style/Text.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/surface"
                        tools:text="300 m" />

                    <TextView
                        android:id="@+id/maneuverText"
                        style="@style/Text.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:textColor="@color/surface"
                        android:textSize="17sp"
                        tools:text="Turn left onto 26th of July St" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/thenText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#DBE7FF"
                android:visibility="gone"
                tools:text="Then: Turn right"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/banner"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round"
            android:backgroundTint="@color/ink"
            android:elevation="6dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/surface"
            android:visibility="gone"
            tools:text="Rerouting…"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/fakeChip"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/action_tint"
            android:elevation="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="#9A3412"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Fake location still on for other apps · Zamalek"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/speedRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/mySpeed"
                style="@style/SpeedSign"
                android:background="@drawable/speed_bg"
                android:contentDescription="@string/nav_my_speed"
                tools:text="55" />

            <TextView
                android:id="@+id/speedLimit"
                style="@style/SpeedSign"
                android:layout_marginStart="8dp"
                android:background="@drawable/speed_limit_bg"
                android:contentDescription="@string/nav_speed_limit"
                tools:text="60" />
        </LinearLayout>

        <TextView
            android:id="@+id/cameraChip"
            style="@style/Text.Item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round"
            android:drawablePadding="6dp"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textSize="15sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_camera"
            app:drawableTint="@color/limit_red"
            tools:text="30 m"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recenterButton"
        style="@style/MapFab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@string/nav_recenter"
        app:icon="@drawable/ic_navigate"
        app:iconTint="@color/real"
        app:layout_constraintBottom_toTopOf="@id/bottomBarrier"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/muteFab"
        style="@style/MapFab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/nav_mute"
        android:visibility="gone"
        app:icon="@drawable/ic_volume"
        app:layout_constraintBottom_toTopOf="@id/recenterButton"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/streetPill"
        style="@style/Text.Item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill"
        android:elevation="4dp"
        android:maxWidth="260dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBarrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Financial Center Rd"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="bottom,driveBar" />

    <LinearLayout
        android:id="@+id/driveBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_round"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driveDistance"
                style="@style/Text.Item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                tools:text="2.2 km" />

            <TextView
                android:id="@+id/driveArrival"
                style="@style/Text.Item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="17sp"
                tools:text="12:55" />

            <TextView
                android:id="@+id/driveMinutes"
                style="@style/Text.Item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="17sp"
                tools:text="6 min" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/endButton"
                style="@style/IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/nav_end"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_close"
                app:iconSize="18dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/driveProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progressBackgroundTint="@color/line"
            android:progressDrawable="@drawable/progress_green" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/etaText"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="12 min · 15:04" />

                <TextView
                    android:id="@+id/summaryText"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="4.3 km · Google live traffic" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/muteButton"
                style="@style/IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/nav_mute"
                android:visibility="gone"
                app:icon="@drawable/ic_volume"
                tools:visibility="visible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mainButton"
            style="@style/Button.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/nav_start"
            app:icon="@drawable/ic_navigate" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

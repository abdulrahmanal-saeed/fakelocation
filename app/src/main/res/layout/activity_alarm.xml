<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="64dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/overline"
        style="@style/Text.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F7A178"
        android:textSize="13sp"
        tools:text="ARRIVING SOON" />

    <TextView
        android:id="@+id/countdown"
        style="@style/Text.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="-0.03"
        android:textColor="@color/surface"
        android:textSize="72sp"
        tools:text="2:00" />

    <TextView
        android:id="@+id/untilText"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/muted_light"
        android:textSize="16sp"
        tools:text="until you reach" />

    <TextView
        android:id="@+id/letter"
        style="@style/Text.Heading"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/fake"
        android:gravity="center"
        android:textColor="@color/surface"
        android:textSize="64sp"
        tools:text="C" />

    <TextView
        android:id="@+id/name"
        style="@style/Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/surface"
        android:textSize="26sp"
        tools:text="Tahrir Square" />

    <TextView
        android:id="@+id/note"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/muted_light"
        tools:text="Then wait 15 min" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dismissButton"
        style="@style/Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        android:text="@string/dismiss"
        android:textColor="@color/ink"
        android:textSize="17sp"
        app:backgroundTint="@color/surface"
        app:cornerRadius="30dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/alarm_footer"
        android:textColor="@color/muted_light" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/tripCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round"
            android:backgroundTint="@color/ink"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tripLetter"
                style="@style/Text.Item"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle"
                android:gravity="center"
                android:textSize="17sp"
                tools:text="C" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tripCaption"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted_light"
                    tools:text="Next stop" />

                <TextView
                    android:id="@+id/tripTitle"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/surface"
                    android:textSize="18sp"
                    tools:text="Tahrir Square" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tripTime"
                    style="@style/Text.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/surface"
                    android:textSize="22sp"
                    tools:text="4 min" />

                <TextView
                    android:id="@+id/tripSub"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted_light"
                    tools:text="1.8 km" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchPill"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/muted" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/search_hint"
                android:textColor="@color/muted"
                android:textSize="16sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingVertical="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/activePill"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/ink"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot"
                android:backgroundTint="@color/fake" />

            <TextView
                style="@style/Text.Overline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/status_on"
                android:textColor="@color/surface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/activeTimer"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted_light"
                android:textSize="14sp"
                tools:text="00:42:10" />
        </LinearLayout>
        <TextView
            android:id="@+id/offlineBanner"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_round"
            android:backgroundTint="@color/ink_soft"
            android:elevation="4dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/offline_banner"
            android:textColor="@color/surface"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/navigateButton"
        style="@style/MapFab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/nav_open"
        app:backgroundTint="@color/real"
        app:icon="@drawable/ic_navigate"
        app:iconTint="@color/surface"
        app:layout_constraintBottom_toTopOf="@id/myLocationButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/parkingButton"
        style="@style/MapFab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/parking_title"
        app:icon="@drawable/ic_parking"
        app:iconTint="@color/nav_blue"
        app:layout_constraintBottom_toTopOf="@id/navigateButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/myLocationButton"
        style="@style/MapFab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@string/my_location"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@color/real"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/mapCredit"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:background="#B3FFFFFF"
        android:paddingHorizontal="4dp"
        android:text="@string/map_credit"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/handle" />

        <!-- Idle -->
        <LinearLayout
            android:id="@+id/idlePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot" />

                <TextView
                    style="@style/Text.Item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/status_off" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off_hint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/teleportButton"
                    style="@style/Button.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/teleport"
                    app:icon="@drawable/ic_pin" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/planRouteButton"
                    style="@style/Button.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/plan_route"
                    app:icon="@drawable/ic_route" />
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/map_tip" />
        </LinearLayout>

        <!-- Trip -->
        <LinearLayout
            android:id="@+id/tripPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/TripStat">
                    <TextView android:id="@+id/stat1Label" style="@style/TripStatLabel" tools:text="Speed" />
                    <TextView android:id="@+id/stat1Value" style="@style/TripStatValue" tools:text="42 km/h" />
                </LinearLayout>

                <LinearLayout style="@style/TripStat">
                    <TextView android:id="@+id/stat2Label" style="@style/TripStatLabel" tools:text="Done" />
                    <TextView android:id="@+id/stat2Value" style="@style/TripStatValue" tools:text="6.9 km" />
                </LinearLayout>

                <LinearLayout style="@style/TripStat">
                    <TextView android:id="@+id/stat3Label" style="@style/TripStatLabel" tools:text="Arrive D" />
                    <TextView android:id="@+id/stat3Value" style="@style/TripStatValue" tools:text="15:00" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/progressRow"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_round"
                android:backgroundTint="@color/action_tint"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/action" />

                <TextView
                    android:id="@+id/tripHint"
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="#9A3412"
                    tools:text="Alarm rings 2 min before C" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tripButton1"
                    style="@style/Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:paddingHorizontal="4dp"
                    android:textSize="14sp"
                    app:iconSize="16dp"
                    tools:text="Pause" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tripButton2"
                    style="@style/Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:paddingHorizontal="4dp"
                    android:textSize="14sp"
                    app:iconSize="16dp"
                    tools:text="Skip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tripStopButton"
                    style="@style/Button.Ink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="54dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/stop"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_stop"
                    app:iconSize="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active -->
        <LinearLayout
            android:id="@+id/activePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Text.Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/phone_thinks"
                android:textColor="@color/action" />

            <TextView
                android:id="@+id/activeName"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="26th of July St, Zamalek" />

            <TextView
                android:id="@+id/activeCoords"
                style="@style/Text.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted"
                android:textSize="14sp"
                tools:text="30.06132, 31.21954" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moveButton"
                    style="@style/Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/move"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_pin"
                    app:iconGravity="top"
                    app:iconPadding="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    style="@style/Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/save"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_star"
                    app:iconGravity="top"
                    app:iconPadding="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/routeFromHereButton"
                    style="@style/Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="@string/route_from_here"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_route"
                    app:iconGravity="top"
                    app:iconPadding="4dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopButton"
                style="@style/Button.Ink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/stop_long"
                app:icon="@drawable/ic_stop" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

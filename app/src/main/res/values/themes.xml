<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Material base; values-night swaps it for the dark one. -->
    <style name="Base.FakeLocation" parent="Theme.Material3.Light.NoActionBar" />

    <style name="Theme.FakeLocation" parent="Base.FakeLocation">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/action</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <!-- Dialogs and sheets use the container colours: keep them the app's own card colour in both themes. -->
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/chip</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.FakeLocation.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.FakeLocation.Dialog</item>
        <item name="textAppearanceTitleLarge">@style/Text.Title</item>
        <item name="textAppearanceBodyLarge">@style/Text.Body</item>
        <item name="textAppearanceBodyMedium">@style/Text.Body</item>
        <item name="textAppearanceLabelLarge">@style/Text.Button</item>
        <item name="textAppearanceLabelMedium">@style/Text.Caption</item>
    </style>

    <style name="Theme.FakeLocation.Starting" parent="Theme.SplashScreen">
        <!-- The logo is made for the dark navy, in both themes. -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.FakeLocation</item>
    </style>

    <style name="Theme.FakeLocation.Transparent" parent="Theme.FakeLocation">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="ThemeOverlay.FakeLocation.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.FakeLocation.BottomSheet</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>

    <style name="Widget.FakeLocation.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/Shape.Sheet</item>
    </style>

    <style name="Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ThemeOverlay.FakeLocation.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/action</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>
    </style>
</resources>
